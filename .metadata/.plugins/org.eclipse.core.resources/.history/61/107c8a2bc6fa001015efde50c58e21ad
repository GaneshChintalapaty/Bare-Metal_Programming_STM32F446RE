#include "stm32f446xx.h"

#define GPIOAEN (1U<<0)
#define GPIOCEN (1U<<2)

int main(void)
{
	//Enable clock access for Port A and C
	RCC->AHB1ENR |= GPIOAEN;
	RCC->AHB1ENR |= GPIOCEN;

	//Set PA5 as output
	GPIOA->MODER |= (1U<<10);
	GPIOA->MODER &=~(1U<<11);

	//Set PC13 as input
	GPIOC->MODER &= ~(1U<<26);
	GPIOC->MODER &= ~(1U<<27);

	while(1)
	{
		//Check if BTN is pressed
		if(GPIOC->IDR == (1U<<13))	//Verify if bit 13 is high
		{
			GPIOA->ODR |= (1U<<5);
		}
		else
		{
			GPIOA->ODR &= ~(1U<<5);
		}
	}
}
